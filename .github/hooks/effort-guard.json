{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [{ "type": "command", "bash": "node copilot/effort-guard.mjs prompt", "timeoutSec": 10 }],
    "postToolUse": [{ "type": "command", "bash": "node copilot/effort-guard.mjs tool", "timeoutSec": 10 }],
    "postToolUseFailure": [{ "type": "command", "bash": "node copilot/effort-guard.mjs failure", "timeoutSec": 10 }]
  }
}
